# Imagination Studio settings. No secrets.
# Docker Compose loads a file named .env. This example is not loaded.
# Copy a line into the environment only when you want to override compose.yaml.

# Host port for the app, published on 127.0.0.1 and 192.168.50.22.
STUDIO_PORT=7870

# Image tag. Pass it on the command line so a value in .env does not hide it:
#   SOURCE_REV=<git short> docker compose build studio
#   SOURCE_REV=<git short> docker compose up -d --force-recreate --no-deps studio

# Data directory inside the app container. The volume imagination-studio-app-data is mounted here.
STUDIO_HOME=/data

# app-only on this Linux deployment. mac and spark are the measured modes on those machines.
STUDIO_MODE=app-only

# Selected GPU from the measured profile. The app container does not receive this device.
STUDIO_GPU_UUID=GPU-82f380a9-0f75-b3d3-8db7-4045bd2dfaeb

# Managed renderer port. This deployment does not start one.
# 8188 is the shared ComfyUI. 8190 is another container. Leave both alone.
STUDIO_COMFY_PORT=8191

# Measured picture profile baked into the image.
SDXL_PROFILE=/opt/studio/docs/benchmarks/rtx3060-images.json

# Discovery inside the container walks only these directories. Empty walks none.
STUDIO_SCAN_ROOTS=

# Free bytes left on the data filesystem before a job is queued. 1 GiB.
# This is not the 8000 MB host-RAM floor.
STUDIO_DISK_RESERVE_BYTES=1073741824
