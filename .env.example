# App-only Studio container. This file has no secrets.
# Do not set HOST=0.0.0.0. Compose publishes 127.0.0.1 only.
STUDIO_PORT=7870
STUDIO_MODE=app-only
STUDIO_HOME=/data
# Unused while rendering is off. Not 8188 and not 8190.
STUDIO_COMFY_PORT=8191
# Passed as the image source revision at build time. Empty here.
SOURCE_REV=
