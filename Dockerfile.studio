# App-only runtime for Wasserman Slate AI Studio.
# This is not Dockerfile.ghcr (the busybox carrier) and it downloads no model weights.
# linux/amd64 python:3.12.15-slim-bookworm, official manifest pinned 2026-10-21.
# uv 0.13.0 linux/amd64 manifest pinned the same day.

FROM --platform=linux/amd64 python:3.12-slim-bookworm@sha256:57d96f71de145a98e7ceca18ee4ade77bba4103a33a72dfaea026b23625c6bf0 AS build

COPY --from=ghcr.io/astral-sh/uv:0.13.0@sha256:22fbda6ef3b6466750a6fb1c7ce1d23a2a63a53be91e03d408b6e4274753998d /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=0 \
    UV_LINK_MODE=copy \
    UV_CONCURRENT_DOWNLOADS=4 \
    MAX_JOBS=2 \
    MAKEFLAGS=-j2

WORKDIR /opt/studio
RUN uv venv /opt/studio/venv
COPY requirements-app.lock /tmp/requirements-app.lock
RUN uv pip install --python /opt/studio/venv/bin/python --require-hashes --no-cache -r /tmp/requirements-app.lock \
    && rm -f /opt/studio/venv/bin/pip /opt/studio/venv/bin/pip3 \
    && /opt/studio/venv/bin/python -c "import fastapi, uvicorn, PIL, numpy"

FROM --platform=linux/amd64 python:3.12-slim-bookworm@sha256:57d96f71de145a98e7ceca18ee4ade77bba4103a33a72dfaea026b23625c6bf0 AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    STUDIO_CONTAINER=1 \
    STUDIO_HOME=/data \
    STUDIO_DISCOVER_DELAY=-1 \
    PORT=7870 \
    PATH=/opt/studio/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg tini ca-certificates util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && ffmpeg -version >/dev/null \
    && ffprobe -version >/dev/null \
    && if command -v gcc || command -v git || command -v nvcc; then echo "runtime image has a compiler or git" >&2; exit 1; fi

RUN groupadd --gid 10001 studio \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin studio \
    && mkdir -p /data /opt/studio/staged-nodes \
    && chown studio:studio /data

COPY --from=build /opt/studio/venv /opt/studio/venv
COPY app /opt/studio/app
COPY scripts /opt/studio/scripts
COPY spark /opt/studio/spark
COPY VERSION /opt/studio/VERSION
# The measured still profile. The checkpoint stays on the host and is mounted read-only.
COPY docs/benchmarks/rtx3060-images.json /opt/studio/docs/benchmarks/rtx3060-images.json
# picture_edit imports this from the pack root. It is the standard library only.
COPY edit_plan.py /opt/studio/edit_plan.py
COPY spark/tensorfold_h3 /opt/studio/staged-nodes/tensorfold_h3
COPY spark/studio_mmaudio /opt/studio/staged-nodes/studio_mmaudio

RUN chmod -R a-w /opt/studio/staged-nodes /opt/studio/app /opt/studio/scripts /opt/studio/spark /opt/studio/VERSION /opt/studio/edit_plan.py /opt/studio/docs/benchmarks/rtx3060-images.json \
    && chmod a+x /opt/studio/scripts/container-entrypoint.sh /opt/studio/scripts/container-healthcheck.py \
    && rm -rf /usr/local/bin/pip /usr/local/bin/pip3 /usr/local/bin/pip3.* \
         /usr/local/lib/python3.12/site-packages/pip \
         /usr/local/lib/python3.12/site-packages/pip-*.dist-info \
         /usr/local/lib/python3.12/ensurepip \
    && if command -v pip || command -v pip3 \
         || /usr/local/bin/python -m pip --version >/dev/null 2>&1 \
         || /opt/studio/venv/bin/python -m pip --version >/dev/null 2>&1; then echo "pip is installed" >&2; exit 1; fi \
    && chown -R root:root /opt/studio \
    && mkdir -p /tmp/studio-import-check \
    && STUDIO_CONTAINER=1 STUDIO_HOME=/tmp/studio-import-check STUDIO_DISCOVER_DELAY=-1 \
       PYTHONDONTWRITEBYTECODE=1 \
       /opt/studio/venv/bin/python -c "import sys; sys.path.insert(0, '/opt/studio/app'); import server; server.end()" \
    && rm -rf /tmp/studio-import-check

ARG SOURCE_REV=unknown
ARG UPSTREAM_REV=unknown
ARG UPSTREAM_REPO=drowzeys/Imagination-Studio-by-keys-Wasserman
ENV STUDIO_REVISION=${SOURCE_REV} \
    STUDIO_UPSTREAM_REV=${UPSTREAM_REV} \
    STUDIO_UPSTREAM=${UPSTREAM_REPO}
LABEL org.opencontainers.image.revision=${SOURCE_REV} \
      org.opencontainers.image.description="Wasserman Slate AI Studio app-only container. No model weights."

WORKDIR /opt/studio
EXPOSE 7870
HEALTHCHECK --interval=15s --timeout=3s --start-period=25s --retries=3 \
    CMD ["/opt/studio/venv/bin/python", "/opt/studio/scripts/container-healthcheck.py"]
ENTRYPOINT ["/usr/bin/tini", "--", "/opt/studio/scripts/container-entrypoint.sh"]

FROM runtime AS test
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.13.0@sha256:22fbda6ef3b6466750a6fb1c7ce1d23a2a63a53be91e03d408b6e4274753998d /uv /usr/local/bin/uv
COPY requirements-test.lock /tmp/requirements-test.lock
RUN uv pip install --python /opt/studio/venv/bin/python --require-hashes --no-cache -r /tmp/requirements-test.lock
COPY tests /opt/studio/tests

FROM runtime
